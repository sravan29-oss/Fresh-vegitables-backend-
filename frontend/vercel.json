{
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|uploads|videos|manifest\\.json|favicon\\.png|apple-touch-icon\\.png|logo\\.png|logo\\.jpg|icon-192\\.png|icon-512\\.png|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
