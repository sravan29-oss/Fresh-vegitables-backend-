# Fresh Vegetables Backend Environment Configuration Example
# Copy this file to .env and provide your actual production / development credentials

# Server
PORT=5000
NODE_ENV=production

# Database (PostgreSQL / Render Postgres / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fresh_vegetables
DB_USER=postgres
DB_PASSWORD=your_password

# Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-min-32-chars
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=365d

# Frontend URL (For CORS and email links)
FRONTEND_URL=https://fresh-vegitables-frontend.vercel.app

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=26214400

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Automated Order Email Alerts (Render Free Tier blocks outbound SMTP ports 25, 465, 587)
# Provider Option 1: Resend API (Recommended - Works on port 443 with zero port-blocking)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Fresh Vegetables <onboarding@resend.dev>

# Provider Option 2: Brevo API (Works on port 443)
BREVO_API_KEY=xkeysib-your_brevo_api_key

# Provider Option 3: Google Apps Script Webhook Relay (100% Free HTTPS endpoint)
GMAIL_RELAY_URL=https://script.google.com/macros/s/YOUR_EXEC_ID/exec

# Provider Option 4: Direct SMTP Configuration (For local dev or paid VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=freshvegitables29@gmail.com
SMTP_PASS=your_16_char_google_app_password

# Notification Settings
ORDER_NOTIFICATION_EMAIL=freshvegitables29@gmail.com
NOTIFY_ADMIN_ON_CANCEL=false
NOTIFY_ADMIN_ON_DELIVERED=false
BUSINESS_TIMEZONE=Asia/Kolkata

# WhatsApp Cloud API (Optional)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
